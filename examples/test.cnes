include "heat_transfer_lib"

h := 100 [W/m^2*K] // Convective heat transfer coefficient
h.unit := [W/m^2*K]
A_c := 0.5
A_c.unit := [m^2]
T_fluid := 20 [C]
Q := 1 [kW]
NewtonCooling(h, A_c, T_surface, T_fluid, Q)
T_surface.unit := [C] // Ensure correct display