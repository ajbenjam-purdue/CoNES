// CoNES Heat and Mass Transfer Library
// Optimized for internal flow and basic HE modeling

// Common Dimensionless Numbers (To be expanded)

function Re(rho, V, D, mu)
    val = (rho * V * D) / mu
    return val [] // Unitless
end function

function Pr(Cp, mu, k)
    val = (Cp * mu) / k
    return val [] // Unitless
end function

function Nu_dittus_boelter(Re, Pr, mode_is_heating)
    n = 0.4
    /* if heating mode=1, n=0.4; if cooling mode=0, n=0.3; TODO: switch/if statements */
    n = 0.3 + 0.1 * mode_is_heating 
    Nu = 0.023 * (Re^0.8) * (Pr^n)
    return Nu [] // Unitless
end function

// Convection coefficient ex

function h_conv(k, D, Nu)
    h = (k / D) * Nu
    return h [W/m^2*K]
end function

// System Routines TODO: Rich integration with vsc

/* 
   HE_energy_balance: 
   Connects two streams via a shared heat transfer rate Q_dot.
   Assumes Q_dot is positive when heat moves from Hot -> Cold.
*/
routine HE_energy_balance(m_dot_h, h_h_in, h_h_out, m_dot_c, h_c_in, h_c_out, Q_dot)
    Q_dot = m_dot_h * (h_h_in - h_h_out)
    Q_dot = m_dot_c * (h_c_out - h_c_in)
end routine

/*
   NewtonCooling:
   Applies convection to a surface.
*/
routine NewtonCooling(h, A, T_surface, T_fluid, Q_conv)
    Q_conv = h * A * (T_surface - T_fluid)
end routine
