{
    "scopeName": "source.cnes",
    "name": "CoNES",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#attribute-block"
        },
        {
            "include": "#units"
        },
        {
            "include": "#definitions"
        },
        {
            "include": "#equations"
        },
        {
            "include": "#dot-notation"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#substances"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.cnes",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.cnes",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.cnes",
                    "match": "\\b[0-9]*\\.?[0-9]+([eE][-+]?[0-9]+)?\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.cnes",
                    "match": "\\b(routine|include)\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function.builtin.cnes",
                    "match": "\\b(Conductivity|Density|Enthalpy|Entropy|InternalEnergy|Prandtl|Pressure|Q_cond|Q_conv|Q_rad|Quality|SpecificVolume|Temperature|Viscosity|abs|acos|asin|atan|ceil|cos|cosh|exp|floor|log|log10|round|sin|sinh|sqrt|tan|tanh)\\b"
                },
                {
                    "name": "support.function.cnes",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*\\()"
                }
            ]
        },
        "definitions": {
            "patterns": [
                {
                    "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:=)",
                    "captures": {
                        "1": {
                            "name": "variable.other.definition.cnes"
                        },
                        "2": {
                            "name": "keyword.operator.assignment.definition.cnes"
                        }
                    }
                }
            ]
        },
        "equations": {
            "patterns": [
                {
                    "match": "(?<!:)(=)",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.comparison.equation.cnes"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.cnes",
                    "match": "[+\\-*/^]"
                },
                {
                    "name": "punctuation.separator.cnes",
                    "match": "[:,.]"
                },
                {
                    "name": "punctuation.brackets.cnes",
                    "match": "[(){}\\[\\]]"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "constant.language.placeholder.cnes",
                    "match": "\\b_\\b"
                },
                {
                    "name": "variable.other.cnes",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "dot-notation": {
            "patterns": [
                {
                    "match": "\\.(guess|lower|upper|unit)\\b",
                    "name": "variable.other.property.cnes"
                },
                {
                    "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "variable.other.property.generic.cnes"
                        }
                    }
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.cnes",
                    "match": "\\b(CONST_E|CONST_GRAV|CONST_PI|CONST_R|CONST_SIGMA|STD_PRESS_BAR|STD_PRESS_KPA|STD_PRESS_MPA|STD_PRESS_PA|STD_TEMP_C|STD_TEMP_K)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.cnes",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.cnes",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "substances": {
            "patterns": [
                {
                    "name": "substance.language.cnes",
                    "match": "\\b(Air|Argon|CO2|Nitrogen|O2|R12|R134a|Water)\\b"
                }
            ]
        },
        "units": {
            "patterns": [
                {
                    "name": "string.other.unit.cnes",
                    "begin": "\\[",
                    "end": "\\]",
                    "patterns": [
                        {
                            "name": "constant.other.unit.symbol.cnes",
                            "match": "[a-zA-Z]+"
                        },
                        {
                            "name": "keyword.operator.arithmetic.cnes",
                            "match": "[*/^]"
                        },
                        {
                            "include": "#numbers"
                        }
                    ]
                }
            ]
        },
        "attribute-block": {
            "patterns": [
                {
                    "name": "meta.block.attributes.cnes",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        {
                            "include": "#numbers"
                        },
                        {
                            "name": "constant.language.placeholder.cnes",
                            "match": "\\b_\\b"
                        },
                        {
                            "name": "punctuation.separator.cnes",
                            "match": ":"
                        }
                    ]
                }
            ]
        }
    }
}